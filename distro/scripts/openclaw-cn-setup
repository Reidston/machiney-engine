#!/bin/bash
# =============================================================================
# OpenClaw WSL — China Region Setup (openclaw-cn-setup)
#
# One-command optimization for users in mainland China:
#   - Switch apt sources to Aliyun mirror
#   - Set DNS to AliDNS + Backup
#   - Install Feishu channel plugin
#
# Usage: openclaw-cn-setup
# =============================================================================

set -euo pipefail

echo "🇨🇳 OpenClaw 中国区域优化"
echo "========================="

# 1. Switch apt to Aliyun mirror
echo "[1/3] 切换 apt 源为阿里云镜像..."
if [ -f /etc/apt/sources.list.d/debian.sources ]; then
    sudo sed -i 's|deb.debian.org|mirrors.aliyun.com|g' /etc/apt/sources.list.d/debian.sources
    echo "  ✅ apt 源已切换至 mirrors.aliyun.com"
elif [ -f /etc/apt/sources.list ]; then
    sudo sed -i 's|deb.debian.org|mirrors.aliyun.com|g' /etc/apt/sources.list
    echo "  ✅ apt 源已切换至 mirrors.aliyun.com"
else
    echo "  ⚠️  未找到 apt 配置文件，跳过"
fi

# 2. Set DNS to AliDNS
echo "[2/3] 设置 DNS 为阿里云 DNS..."
sudo bash -c 'printf "nameserver 223.5.5.5\nnameserver 8.8.8.8\nnameserver 114.114.114.114\n" > /etc/resolv.conf'
echo "  ✅ DNS: 223.5.5.5 + 8.8.8.8 + 114.114.114.114"

# 3. Install Feishu plugin (if network available)
echo "[3/3] 安装飞书 (Feishu) 消息平台插件..."
if openclaw plugins install feishu 2>&1; then
    echo "  ✅ 飞书插件安装成功"
    echo ""
    echo "📱 飞书配置说明:"
    echo "   运行: openclaw channels add --channel feishu"
    echo "   根据提示输入飞书机器人的 App ID 和 App Secret"
else
    echo "  ⚠️  飞书插件安装失败（可稍后运行 openclaw plugins install feishu）"
fi

echo ""
echo "========================="
echo "✅ 中国区域优化完成！"
echo ""
echo "后续步骤:"
echo "  1. 配置 LLM:  openclaw models auth"
echo "  2. 配置飞书:   openclaw channels add --channel feishu"
echo "  3. 重启服务:   sudo systemctl restart openclaw-gateway.service"
echo "========================="
